# Hugo extended and Go, at the versions CI uses. Docsy needs Hugo extended
# 0.160.1+, and Hugo needs Go to download the Docsy module.
ARG TARGETARCH
ARG HUGO_VERSION=0.169.0
ARG GO_VERSION=1.24.4
RUN set -eux; \
    curl -fsSL "https://github.com/gohugoio/hugo/releases/download/v${HUGO_VERSION}/hugo_extended_${HUGO_VERSION}_linux-${TARGETARCH}.tar.gz" \
      | tar -xz -C /usr/local/bin hugo; \
    curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-${TARGETARCH}.tar.gz" | tar -xz -C /usr/local; \
    ln -s /usr/local/go/bin/go /usr/local/bin/go
